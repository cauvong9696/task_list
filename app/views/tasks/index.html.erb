<% content_for :title, "Tasks" %>

<header class="page-header">
  <h1>Tasks</h1>
  <%= link_to "+ New task", new_task_path, class: "button" %>
</header>

<%# Vue-powered interactive list; falls back to a plain list without JS. %>
<div id="task-list-app"
     data-csrf="<%= form_authenticity_token %>"
     data-tasks="<%= tasks_json(@tasks) %>">
  <noscript>
    <% if @tasks.any? %>
      <ul class="task-list">
        <% @tasks.each do |task| %>
          <li class="task">
            <%= link_to task.title, task %>
            — complete by <%= task.complete_by.strftime("%b %-d, %Y at %I:%M %p") %>
            <%= "(done)" if task.completed? %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="empty">No tasks yet. Create your first one.</p>
    <% end %>
  </noscript>
</div>
