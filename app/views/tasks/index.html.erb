<% content_for :title, "Tasks" %>

<header class="page-header">
  <h1>Tasks</h1>
  <%= link_to "+ New task", new_task_path, class: "button" %>
</header>

<%# Vue owns the toolbar, list and pagination so search filters as you type
    (debounced) without a full page reload. Initial data is embedded to avoid
    an extra request on load. %>
<div id="task-list-app"
     data-csrf="<%= form_authenticity_token %>"
     data-filters="<%= TasksController::FILTERS.to_json %>"
     data-initial="<%= @list_payload.to_json %>">
  <noscript>
    <div class="toolbar">
      <nav class="filters">
        <% TasksController::FILTERS.each do |key| %>
          <%= link_to tasks_url_with(filter: key, page: nil),
                      class: ("active" if @filter == key) do %>
            <%= filter_label(key) %> (<%= @counts[key] %>)
          <% end %>
        <% end %>
      </nav>

      <%= form_with url: tasks_path, method: :get, class: "search-form" do |f| %>
        <%= f.hidden_field :filter, value: @filter %>
        <%= f.search_field :q, value: @query, placeholder: "Search tasks…", class: "search" %>
      <% end %>
    </div>

    <% if @tasks.any? %>
      <ul class="task-list">
        <% @tasks.each do |task| %>
          <li class="task <%= "overdue" if task.overdue? %>">
            <%= link_to task.title, task %>
            — complete by <%= task.complete_by.strftime("%b %-d, %Y at %I:%M %p") %>
            <% if task.completed? %>(done)<% elsif task.overdue? %>(overdue)<% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="empty">No tasks match this view.</p>
    <% end %>

    <% if @total_pages > 1 %>
      <nav class="pagination">
        <%= link_to "← Prev", tasks_url_with(page: @page - 1) if @page > 1 %>
        <span class="page-info">Page <%= @page %> of <%= @total_pages %></span>
        <%= link_to "Next →", tasks_url_with(page: @page + 1) if @page < @total_pages %>
      </nav>
    <% end %>
  </noscript>
</div>
