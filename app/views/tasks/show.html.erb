<% content_for :title, @task.title %>

<header class="page-header">
  <h1><%= @task.title %></h1>
  <%= link_to "← Back to tasks", tasks_path %>
</header>

<div class="card">
  <p>
    <strong>Status:</strong>
    <% if @task.completed? %>
      Completed on <%= @task.completed_at.strftime("%b %-d, %Y at %I:%M %p") %>
    <% elsif @task.overdue? %>
      <span class="badge-overdue">Overdue</span>
    <% else %>
      Pending
    <% end %>
  </p>
  <div class="description">
    <strong>Description:</strong>
    <% if @task.description.present? %>
      <div class="markdown-body"><%= render_markdown(@task.description) %></div>
    <% else %>
      <span class="muted">(no description)</span>
    <% end %>
  </div>
  <p><strong>Complete by:</strong> <%= @task.complete_by.strftime("%b %-d, %Y at %I:%M %p") %></p>
  <p><strong>Author:</strong> <%= @task.user.email %></p>
  <p><strong>Created:</strong> <%= @task.created_at.strftime("%b %-d, %Y at %I:%M %p") %></p>

  <div>
    <strong>Supporting files:</strong>
    <% if @task.supporting_files.attached? %>
      <ul class="attachment-list">
        <% @task.supporting_files.each do |file| %>
          <li>
            <%= link_to file.filename, rails_blob_path(file, only_path: true), target: "_blank", rel: "noopener" %>
            <span class="attachment-size">(<%= number_to_human_size(file.byte_size) %>)</span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <span class="muted">(none)</span>
    <% end %>
  </div>

  <div class="actions">
    <%= button_to @task.completed? ? "Mark as pending" : "Mark as complete", toggle_task_path(@task), method: :patch %>
    <%= link_to "Edit", edit_task_path(@task), class: "button" %>
    <%= link_to "Copy", new_task_path(copy_from: @task), class: "button" %>
    <%= button_to "Delete", @task, method: :delete, data: { turbo_confirm: "Delete this task?" }, class: "button-danger" %>
  </div>
</div>
